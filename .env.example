# ─────────────────────────────────────────────────────────────────────────────
# Postgres connection
#
# Any Postgres works. Neon's free tier is what this was built against:
# https://console.neon.tech → create a project → Connection Details
#
# Copy this file to .env and paste your connection string below. The app also
# reads DATABASE_URL from Streamlit Cloud secrets when deployed, so this file
# is only for local development.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/talent_market?sslmode=require


# ─────────────────────────────────────────────────────────────────────────────
# Local Postgres instead? Point at it directly — no other config changes:
#
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/talent_market
# ─────────────────────────────────────────────────────────────────────────────
