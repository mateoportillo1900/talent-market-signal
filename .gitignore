# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Raw downloads ────────────────────────────────────────────────────────────
# scripts/build_dataset.py caches the raw BLS / O*NET archives here. They are
# large (~150 MB) and fully reproducible, so they never get committed. The
# small filtered Parquet files in data/ ARE committed — they are the artifact
# the app actually reads.
data/raw/

# ── Synthetic fixture ────────────────────────────────────────────────────────
# Generated by scripts/make_fixture.py for tests and CI. Never committed, so
# it can never be mistaken for the real dataset.
data/fixture/

# ── Program Health local log ─────────────────────────────────────────────────
# Written at runtime as reports are generated. Ephemeral by design.
data/report_log.csv

# ── Secrets ──────────────────────────────────────────────────────────────────
# .env holds a live Postgres connection string with credentials in it. The
# committed template is .env.example; the real file never leaves the machine.
.env
.env.*
!.env.example
*.pem
secrets.toml
.streamlit/secrets.toml

# ── Local Claude context ─────────────────────────────────────────────────────
# .claude/ is committed so CLAUDE.md conventions and shared settings travel
# with the repo, but anything marked .local stays private: job notes, interview
# prep, credentials guidance, working scratch.
.claude/*.local.md
.claude/settings.local.json
.claude/scratch/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
